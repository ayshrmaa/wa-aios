# The API process owns the database. Point the dashboard at it:
AIOS_API_URL=http://localhost:3010
DASHBOARD_API_TOKEN=            # must match DASHBOARD_API_TOKEN on the API
RETELL_WEBHOOK_SECRET=          # lets the dashboard change lead status via the API webhooks

# Owner login. Leave DASHBOARD_PASSWORD empty for an open demo (snapshot mode only — never in production).
DASHBOARD_PASSWORD=
DASHBOARD_SESSION_SECRET=       # optional, defaults to the password

# Multi-tenant deployments: which salon this dashboard shows
NEXT_PUBLIC_DEMO_TENANT_ID=11111111-1111-4111-8111-111111111111
