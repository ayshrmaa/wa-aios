# Point the dashboard at the deployed API (the API process owns the database).
AIOS_API_URL=https://wa-aios-api.onrender.com
DASHBOARD_API_TOKEN=            # must match DASHBOARD_API_TOKEN on the API

# Which salon this dashboard shows by default. For multi-salon, also set
# DASHBOARD_TENANT_IDS on the API and the sidebar shows a salon switcher.
NEXT_PUBLIC_DEMO_TENANT_ID=11111111-1111-4111-8111-111111111111

# Owner login. Empty = open (only acceptable for a local demo).
DASHBOARD_PASSWORD=
DASHBOARD_SESSION_SECRET=       # optional, defaults to the password
