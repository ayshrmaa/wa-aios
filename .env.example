# Shared demo tenant config
TENANT_CONFIG_PATH=./config/tenant.demo.json

# Postgres / Supabase (server-side only)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wa_aios
NEXT_PUBLIC_DEMO_TENANT_ID=11111111-1111-4111-8111-111111111111

# n8n workflow environment. Replace with your own n8n Cloud hostname.
N8N_WEBHOOK_BASE_URL=https://YOUR-SUBDOMAIN.app.n8n.cloud

# Live messaging adapter. Leave unset while messaging.mode is "stub".
MESSAGING_TRANSPORT_URL=
MESSAGING_TRANSPORT_TOKEN=

# Provider credentials are configured in n8n's encrypted credential store, not here.
GOOGLE_CALENDAR_CREDENTIAL_NAME=Google Calendar account
POSTGRES_CREDENTIAL_NAME=WA AIOS Postgres

# Optional audit-generator overrides
AUDIT_OUTPUT_DIR=./audit-generator/output/pdf
