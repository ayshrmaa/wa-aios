      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [
        -64,
        1216
      ],
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "BxQoTuZajdsADPPC",
          "name": "Google Calendar account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Get configuration from Workflow Configuration node\nconst config = $('Workflow Configuration1').first().json;\nconst requestedStartTime = new Date(config.requestedStartTime);\nconst dateRangeStart = new Date(config.dateRangeStart);\nconst dateRangeEnd = new Date(config.dateRangeEnd);\nconst slotDuration = 60; // 60 minutes\n\n// Get booked events from Get Events in Range node\nconst bookedEvents = $input.all().map(item => ({\n  start: new Date(item.json.start.dateTime || item.json.start.date),\n  end: new Date(item.json.end.dateTime || item.json.end.date)\n}));\n\n// Function to check if a slot overlaps with any booked event\nfunction isSlotAvailable(slotStart, slotEnd) {\n  return !bookedEvents.some(event => {\n    return (slotStart < event.end && slotEnd > event.start);\n  });\n}\n\n// Generate all possible slots on the hour within the date range\nconst availableSlots = [];\nlet currentSlot = new Date(dateRangeStart);\n\n// Round to next hour\ncurrentSlot.setMinutes(0, 0, 0);\nif (currentSlot < dateRangeStart) {\n  currentSlot.setHours(currentSlot.getHours() + 1);\n}\n\nwhile (currentSlot < dateRangeEnd) {\n  const slotEnd = new Date(currentSlot.getTime() + slotDuration * 60000);\n  \n  if (slotEnd <= dateRangeEnd && isSlotAvailable(currentSlot, slotEnd)) {\n    availableSlots.push({\n      start: new Date(currentSlot),\n      end: new Date(slotEnd)\n    });\n  }\n  \n  currentSlot.setHours(currentSlot.getHours() + 1);\n}\n\n// Find the 3 closest alternatives to the requested start time\nconst slotsWithDistance = availableSlots.map(slot => ({\n  ...slot,\n  distance: Math.abs(slot.start - requestedStartTime)\n}));\n\nslotsWithDistance.sort((a, b) => a.distance - b.distance);\n\nconst closestSlots = slotsWithDistance.slice(0, 3).map(slot => ({\n  start: slot.start.toISOString(),\n  end: slot.end.toISOString()\n}));\n\nreturn [{\n  json: {\n    requestedTime: requestedStartTime.toISOString(),\n    alternativeSlots: closestSlots,\n    totalAvailableSlots: availableSlots.length\n  }\n}];"
      },
