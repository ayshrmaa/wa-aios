    {
      "parameters": {
        "jsCode": "// Get input data from webhook and configuration\nconst webhookData = $('Check & Book').first().json.body;\nconst requestedTime = new Date(webhookData.startTime);\nconst appointmentDuration = $('Workflow Configuration').first().json.appointmentDuration || 60;\nconst workingHoursStart = $('Workflow Configuration').first().json.workingHoursStart || 9;\nconst workingHoursEnd = $('Workflow Configuration').first().json.workingHoursEnd || 17;\nconst searchRangeDays = $('Workflow Configuration').first().json.searchRangeDays || 10;\n\n// Get all existing events from previous node\nconst events = $input.all().map(item => item.json);\n\n// Helper function to check if a time slot is available\nfunction isSlotAvailable(startTime, durationMinutes, events) {\n  const endTime = new Date(startTime.getTime() + durationMinutes * 60000);\n  \n  for (const event of events) {\n    const eventStart = new Date(event.start.dateTime || event.start.date);\n    const eventEnd = new Date(event.end.dateTime || event.end.date);\n    \n    // Check for overlap\n    if (startTime < eventEnd && endTime > eventStart) {\n      return false;\n    }\n  }\n  return true;\n}\n\n// Helper function to check if time is within working hours\nfunction isWithinWorkingHours(time, workingHoursStart, workingHoursEnd) {\n  const hour = time.getHours();\n  const minutes = time.getMinutes();\n  const timeInMinutes = hour * 60 + minutes;\n  const startInMinutes = workingHoursStart * 60;\n  const endInMinutes = workingHoursEnd * 60;\n  \n  return timeInMinutes >= startInMinutes && timeInMinutes + appointmentDuration <= endInMinutes;\n}\n\n// Helper function to calculate time difference in minutes\nfunction getTimeDifference(time1, time2) {\n  return Math.abs(time1.getTime() - time2.getTime()) / 60000;\n}\n\n// Find all available slots within search range\nconst availableSlots = [];\nconst startDate = new Date(requestedTime);\nstartDate.setHours(0, 0, 0, 0);\n\nfor (let day = 0; day < searchRangeDays; day++) {\n  const currentDay = new Date(startDate);\n  currentDay.setDate(startDate.getDate() + day);\n  \n  // Skip weekends (optional - remove if weekends should be included)\n  const dayOfWeek = currentDay.getDay();\n  if (dayOfWeek === 0 || dayOfWeek === 6) continue;\n  \n  // Set to start of working hours\n  currentDay.setHours(workingHoursStart, 0, 0, 0);\n  \n  const dayEnd = new Date(currentDay);\n  dayEnd.setHours(workingHoursEnd, 0, 0, 0);\n  \n  // Check every 30-minute slot\n  for (let time = new Date(currentDay); time < dayEnd; time.setMinutes(time.getMinutes() + 30)) {\n    const slotTime = new Date(time);\n    \n    if (isWithinWorkingHours(slotTime, workingHoursStart, workingHoursEnd) && \n        isSlotAvailable(slotTime, appointmentDuration, events)) {\n      \n      const endTime = new Date(slotTime.getTime() + appointmentDuration * 60000);\n      const timeDiff = getTimeDifference(slotTime, requestedTime);\n      const isSameDay = slotTime.toDateString() === requestedTime.toDateString();\n      \n      availableSlots.push({\n        startTime: slotTime.toISOString(),\n        endTime: endTime.toISOString(),\n        formatted: slotTime.toLocaleString('en-US', {\n          weekday: 'long',\n          year: 'numeric',\n          month: 'long',\n          day: 'numeric',\n          hour: 'numeric',\n          minute: '2-digit',\n          hour12: true\n        }),\n        timeDifference: timeDiff,\n        isSameDay: isSameDay,\n        date: slotTime.toISOString().split('T')[0]\n      });\n    }\n  }\n}\n\n// Rank slots by proximity to requested time\n// Priority: 1) Same day slots first, 2) Then by closest time difference\navailableSlots.sort((a, b) => {\n  // Same day slots get priority\n  if (a.isSameDay && !b.isSameDay) return -1;\n  if (!a.isSameDay && b.isSameDay) return 1;\n  \n  // Then sort by time difference\n  return a.timeDifference - b.timeDifference;\n});\n\n// Get top 3 closest available times\nconst top3Slots = availableSlots.slice(0, 3);\n\n// Format output for response\nconst suggestedTimes = top3Slots.map(slot => ({\n  startTime: slot.startTime,\n  endTime: slot.endTime,\n  formatted: slot.formatted\n}));\n\nreturn {\n  json: {\n    suggestedTimes: suggestedTimes,\n    requestedTime: requestedTime.toISOString(),\n    totalSlotsFound: availableSlots.length,\n    searchedDays: searchRangeDays,\n    appointmentDuration: appointmentDuration\n  }\n};"
      },
